# ROM e dados extraídos ficam fora do controle de versão (DESIGN §3).
# A pasta inteira é ignorada, não a extensão: *.md é extensão de ROM de Mega Drive.
roms/
assets/*
!assets/shaders/
# Modelos do upscale B+ (pesos .bin/.onnx usados em runtime + checkpoints .pt do treino; arquivos pequenos)
!assets/models/
# SoundFont do remaster de audio (TimGM6mb, GPL-2.0)
!assets/soundfonts/
# Modo C (HD): arte 4x AnimeSharp aprovada + originais que o jogo usa para reconhecer sprites/planos
# (o conjunto do pipeline/manifest.json). Planos Flux (assets/hd/planes) e tiles ficam de fora.
!assets/hd/
assets/hd/*
!assets/hd/sprites/
!assets/hd/planes_v3/
!assets/catalog/
assets/catalog/*
!assets/catalog/sprites/
!assets/catalog/indices/
!assets/catalog/planes/
# Remaster de áudio: versiona só os .toml (perfis, voices.toml); os MIDIs são
# derivados da ROM e ficam de fora. O .sf2 (assets/soundfonts/) segue ignorado.
!assets/audio_remaster/
assets/audio_remaster/midi/
assets/audio_remaster/midi_voices/

# Gerados por tools/split.py (dados extraídos da ROM)
disasm/data/

# Evidence do REA (contém conteúdo derivado da ROM — fora do versionamento)
reference/rea/

# Builds e artefatos
build/
out/
*.o
*.obj

# Python
__pycache__/
*.pyc
.venv/

# Node (não usado pelo projeto)
node_modules/

# Ferramentas externas baixadas localmente
# (usamos tools/vendor/* em vez de tools/vendor/ para poder re-incluir
#  as ferramentas PRÓPRIAS do projeto que vivem junto aos vendors)
tools/vendor/*
!tools/vendor/README.md
!tools/vendor/ares_cli/
!tools/vendor/gpgx_runner/

# Artefatos de build das ferramentas próprias (não versionados)
tools/vendor/ares_cli/build/
tools/vendor/gpgx_runner/gpgx_runner
tools/vendor/gpgx_runner/gpgx_runner_dbg


# Projetos de referência: ferramentas externas, não fazem parte do repo (DESIGN §5.1)
ares/
StreetsOfRageProject/
sonic3air-*/
RGen-*/

# IDE/editor
.vscode/
.idea/
*.swp

# Caches regeneráveis de grafos de conhecimento
graphify-out/cache/
tools/.engram/cache/
# Dumps de RAM/VRAM derivados da ROM gerados por engano pelo gpgx_runner
tools/vendor/gpgx_runner/[0-9]*

neural/.pydeps/

# Pacote OptiScaler/FidelityFX (DLLs de terceiros, ~282 MB): fica so no disco
Optiscaler_*/

# --- Triagem 2026-11-25: fora do repositorio, mantidos so no disco ---
# Configuracao de agentes de IA
/CLAUDE.md
/AGENTS.md
/.claude/
/.agents/
# Residuos
*.bak
/package.json
/package-lock.json
/tools/audio/legacy/
/tools/scripts/t2_repro/
/tools/scripts/t4_repro/
/tools/scripts/cuda-env.sh
/docs/movelist_investigation.md
/docs/proposta_bugfix_2026-11-21.md
# Gerados (regeneraveis)
screenshots/
/graphify-out/
/docs/frame_data/fight_probe_summary.md

# Desmontagem do codigo da ROM (material de pesquisa, nao usado pelo build): fica so no disco
/disasm/

# Pacotes gerados por packaging/ (instaladores, .deb, .tar.gz)
/packaging/out/
